{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Louis Desktop",
  "version": "0.1.0",
  "identifier": "dev.qntology.louis-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Louis Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 56
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/lv_accel_probe",
      "binaries/louis-vision-app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
